// Schéma + migrations uniquement.
// Le runtime de l'API utilise `pg` via server/db.js (pas Prisma Client).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  displayName  String?
  avatarUrl    String?
  birthDate    DateTime?
  role         String    @default("user")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  progress    ReadingProgress[]
  favorites   Favorite[]
  history     ReadingHistory[]
  preferences UserPreference?
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  storyId    String
  sceneIndex Int      @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

model ReadingHistory {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  eventType String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id           String @id @default(cuid())
  userId       String @unique
  defaultLang  String @default("fr")
  spokenLang   String @default("fr")
  learningLang String @default("en")
  level        String @default("debutant")
  ageBand      String @default("moyens")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Catalogue d'histoires (source de vérité). Les images restent dans uploads/<id>/.
model Story {
  id           String   @id
  title        String
  titleAr      String?
  thumbnail    String?
  ageCategory  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scenes Scene[]
}

model Scene {
  id              String @id @default(cuid())
  storyId         String
  sceneKey        Int?
  sortIndex       Int
  image           String?
  characterName   String?
  characterAvatar String?
  text            Json

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, sortIndex])
  @@index([storyId])
}
